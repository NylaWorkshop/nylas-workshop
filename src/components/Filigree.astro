---
interface Props {
  flip?: boolean;
}

const { flip = false } = Astro.props;
---

<div class:list={["filigree", flip && "filigree-flip"]} aria-hidden="true">
  <svg class="filigree-end" viewBox="0 0 48 56" fill="none">
    <path d="M24 2 L26.2 10.2 L34 12 L26.2 13.8 L24 22 L21.8 13.8 L14 12 L21.8 10.2 Z" fill="currentColor" />
    <path d="M24 22 V34" stroke="currentColor" stroke-width="1.1" />
    <path d="M24 40.5c-4.2 0-7.6-3.2-7.6-7.2 3.2.4 6.2 2.4 7.6 5.6 1.4-3.2 4.4-5.2 7.6-5.6 0 4-3.4 7.2-7.6 7.2z" fill="currentColor" />
  </svg>

  <span class="filigree-stem"></span>

  <svg class="filigree-jewel" viewBox="0 0 48 48" fill="currentColor">
    <path d="M24 6 L27 18 L39 21 L27 24 L24 36 L21 24 L9 21 L21 18 Z" opacity="0.95" />
    <circle cx="24" cy="21" r="2.1" fill="#0a0a0b" />
  </svg>

  <span class="filigree-stem"></span>

  <svg class="filigree-end filigree-end-bottom" viewBox="0 0 48 56" fill="none">
    <path d="M24 15.5c-4.2 0-7.6 3.2-7.6 7.2 3.2-.4 6.2-2.4 7.6-5.6 1.4 3.2 4.4 5.2 7.6 5.6 0-4-3.4-7.2-7.6-7.2z" fill="currentColor" />
    <path d="M24 34 V22" stroke="currentColor" stroke-width="1.1" />
    <path d="M24 54 L26.2 45.8 L34 44 L26.2 42.2 L24 34 L21.8 42.2 L14 44 L21.8 45.8 Z" fill="currentColor" />
  </svg>
</div>
