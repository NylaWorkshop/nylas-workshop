---
import { kofiUrl } from "../data/support";
import type { Lang } from "../i18n/ui";
import { localizePath, useTranslations } from "../i18n/utils";
import PawPrint from "./PawPrint.astro";

const lang = (Astro.currentLocale ?? "es") as Lang;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-gold/15">
  <div class="mx-auto max-w-6xl px-5 py-10">
    <div class="flourish mb-6">
      <span class="flourish-line"></span>
      <PawPrint size={22} />
      <span class="flourish-line"></span>
    </div>

    <div class="flex flex-col items-center gap-3 text-center">
      <p class="max-w-md text-sm text-muted">
        {t("footer.blurb")}
      </p>
      <p class="mt-4 max-w-md text-sm text-cream">
        {t("footer.supportBefore")}
        <a
          class="text-gold underline decoration-gold/50 underline-offset-4 transition hover:text-gold-soft hover:decoration-gold"
          href={kofiUrl}
          target="_blank"
          rel="noopener noreferrer"
        >{t("footer.supportHere")}</a>
        .
      </p>
      <nav class="mt-5 flex flex-wrap justify-center gap-5 text-[0.7rem] uppercase tracking-[0.24em] text-paper/70">
        <a class="hover:text-gold" href={localizePath(lang, "/")}>{t("nav.home")}</a>
        <a class="hover:text-gold" href={localizePath(lang, "/bookstore")}>{t("nav.bookstore")}</a>
        <a class="hover:text-gold" href={localizePath(lang, "/music")}>{t("nav.music")}</a>
        <a class="hover:text-gold" href={localizePath(lang, "/stories")}>{t("nav.stories")}</a>
        <a class="hover:text-gold" href={localizePath(lang, "/games")}>{t("nav.games")}</a>
        <a class="hover:text-gold" href={localizePath(lang, "/code")}>{t("nav.code")}</a>
        <a class="hover:text-gold" href={localizePath(lang, "/merch")}>{t("nav.merch")}</a>
      </nav>
      <p class="mt-4 text-xs text-muted/80">© {year} Nyla's Workshop</p>
    </div>
  </div>
</footer>
