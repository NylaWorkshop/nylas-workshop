---
import "../styles/reader.css";
import type { StoryRecord } from "../lib/stories";

interface Props {
  stories: StoryRecord[];
  ui: {
    shelf: string;
    shelfAria: string;
    now: string;
    readTime: string;
    folios: string;
    end: string;
    top: string;
    note: string;
    prev: string;
    next: string;
    spreadAria: string;
    spreadOf: string;
  };
}

const { stories, ui } = Astro.props;

// Los folios del markdown (<!-- page -->) ya no son páginas de un libro: se
// encadenan en un solo hilo de lectura y la marca queda como respiro.
function buildBody(story: StoryRecord) {
  const parts: string[] = [];
  let dropDone = false;
  let prevKind: string | null = null;

  for (const leaf of story.pages) {
    if (prevKind === "text" && leaf.kind === "text") {
      parts.push('<div class="reader-break" aria-hidden="true"></div>');
    }

    let html = leaf.html;
    if (!dropDone && leaf.kind === "text" && html.startsWith("<p>")) {
      html = html.replace("<p>", '<p class="drop">');
      dropDone = true;
    }

    // Los párrafos de diálogo (raya o comillas) llevan sangría francesa.
    html = html.replace(/<p>(?=[—–«“])/g, '<p class="speech">');

    parts.push(`<div class="reader-folio" data-kind="${leaf.kind}">${html}</div>`);
    prevKind = leaf.kind;
  }

  return parts.join("");
}

function readingMinutes(story: StoryRecord) {
  const words = story.pages
    .map((leaf) => leaf.html.replace(/<[^>]+>/g, " "))
    .join(" ")
    .split(/\s+/)
    .filter(Boolean).length;
  return Math.max(1, Math.round(words / 180));
}

const items = stories.map((story) => {
  const minutes = readingMinutes(story);
  return {
    story,
    id: `relato-${story.slug}`,
    body: buildBody(story),
    time: `${minutes} ${ui.readTime}`,
    meta: `${story.pages.length} ${ui.folios} · ${minutes} ${ui.readTime}`,
  };
});
---

<noscript><style>
  .reader-story[hidden] { display: block; }
  /* Sin JS no se puede pasar de hoja: el relato vuelve a ser una columna larga. */
  .reader-spread { height: auto !important; columns: 1 !important; overflow: visible !important; }
  .reader-spine { display: none !important; }
</style></noscript>

<section class="reader" data-reader>
  {items.length > 0 ? (
    <>
      <div class="mx-auto max-w-6xl px-5 pt-6">
        <div class="flourish">
          <span class="flourish-line"></span>
          <h2 class="font-display gold-text text-lg tracking-[0.18em] uppercase md:text-xl">
            {ui.shelf}
          </h2>
          <span class="flourish-line"></span>
        </div>

        <nav class="shelf" aria-label={ui.shelfAria}>
          {items.map((item, i) => (
            <a
              class="shelf-item"
              href={`#${item.id}`}
              data-pick={item.id}
              aria-current={i === 0 ? "true" : "false"}
            >
              <span class="shelf-mark" aria-hidden="true"></span>
              <span class="shelf-cover">
                {item.story.cover ? (
                  <img src={item.story.cover} alt="" loading="lazy" />
                ) : (
                  <span class="shelf-cover-blank" aria-hidden="true">
                    {item.story.title.slice(0, 1)}
                  </span>
                )}
              </span>
              <span class="shelf-body">
                {item.story.kicker && <span class="shelf-kicker">{item.story.kicker}</span>}
                <span class="shelf-title">{item.story.title}</span>
                {item.story.blurb && <span class="shelf-blurb">{item.story.blurb}</span>}
                <span class="shelf-meta">
                  <span class="shelf-now">{ui.now} · </span>{item.time}
                </span>
              </span>
            </a>
          ))}
        </nav>
      </div>

      <div class="reader-stack mx-auto max-w-6xl px-5">
        {items.map((item, i) => (
          <article class="reader-story" id={item.id} data-story hidden={i !== 0}>
            <div class="reader-bar">
              <span class="reader-bar-title">{item.story.title}</span>
              <span class="reader-bar-track" aria-hidden="true"><i data-progress></i></span>
            </div>

            <header class="reader-head">
              {item.story.kicker && <p class="banner-title">{item.story.kicker}</p>}
              <h3 class="reader-title gold-text">{item.story.title}</h3>
              {item.story.blurb && <p class="reader-blurb">{item.story.blurb}</p>}
              <p class="reader-meta">{item.meta}</p>
              <div class="reader-rule" aria-hidden="true">
                <span></span><i>✦</i><span></span>
              </div>
            </header>

            <div class="reader-book" data-book>
              <div
                class="reader-prose reader-spread"
                data-pages
                tabindex="0"
                role="region"
                aria-label={ui.spreadAria}
                set:html={item.body}
              />
              <span class="reader-spine" aria-hidden="true"></span>
            </div>

            <nav class="reader-nav" data-nav hidden>
              <button type="button" class="reader-turn" data-prev>
                <span aria-hidden="true">‹</span> {ui.prev}
              </button>
              <p class="reader-folionum" data-folio data-template={ui.spreadOf} aria-live="polite"></p>
              <button type="button" class="reader-turn" data-next>
                {ui.next} <span aria-hidden="true">›</span>
              </button>
            </nav>

            <footer class="reader-end">
              <div class="reader-rule" aria-hidden="true">
                <span></span><i>✦</i><span></span>
              </div>
              <p class="reader-end-text mt-5">{ui.end}</p>
              <a class="btn-gold-outline" href="#" data-back>{ui.top}</a>
            </footer>
          </article>
        ))}
      </div>
    </>
  ) : (
    <p class="reader-empty">{ui.note}</p>
  )}
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-reader]").forEach((root) => {
    const picks = Array.from(root.querySelectorAll<HTMLAnchorElement>("[data-pick]"));
    const stories = Array.from(root.querySelectorAll<HTMLElement>("[data-story]"));
    if (!stories.length) return;

    const shelf = root.querySelector<HTMLElement>(".shelf");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    // Alto de la cabecera pegajosa: lo que hay que descontar al hacer scroll.
    const headerOffset = () => {
      const header = document.querySelector("header");
      return header ? header.getBoundingClientRect().height : 0;
    };

    function show(id: string, scroll: boolean) {
      const target = stories.find((story) => story.id === id);
      if (!target) return;

      for (const story of stories) story.hidden = story !== target;
      for (const pick of picks) {
        pick.setAttribute("aria-current", pick.dataset.pick === id ? "true" : "false");
      }

      // El relato oculto mide 0: hay que rehacer las hojas al mostrarlo.
      books.get(target)?.measure();

      if (scroll) {
        const top = target.getBoundingClientRect().top + window.scrollY - headerOffset() - 8;
        window.scrollTo({ top, behavior: reduceMotion.matches ? "auto" : "smooth" });
      }
    }

    for (const pick of picks) {
      pick.addEventListener("click", (event) => {
        const id = pick.dataset.pick;
        if (!id) return;
        event.preventDefault();
        // El hash queda en la barra para poder compartir el relato.
        history.replaceState(null, "", `#${id}`);
        show(id, true);
      });
    }

    root.querySelectorAll<HTMLAnchorElement>("[data-back]").forEach((back) => {
      back.addEventListener("click", (event) => {
        event.preventDefault();
        const top = (shelf ?? root).getBoundingClientRect().top + window.scrollY - headerOffset() - 24;
        window.scrollTo({ top, behavior: reduceMotion.matches ? "auto" : "smooth" });
      });
    });

    // ---------------------------------------------------------- El libro --
    // Cada relato se maqueta como un tomo abierto: dos columnas de altura fija
    // y el resto del texto en columnas que se quedan fuera del recuadro. Pasar
    // de hoja es mover el scroll horizontal justo un par de columnas.
    const books = new Map<HTMLElement, { measure: () => void }>();

    for (const story of stories) {
      const pages = story.querySelector<HTMLElement>("[data-pages]");
      const nav = story.querySelector<HTMLElement>("[data-nav]");
      if (!pages || !nav) continue;

      const folio = nav.querySelector<HTMLElement>("[data-folio]");
      const prev = nav.querySelector<HTMLButtonElement>("[data-prev]");
      const next = nav.querySelector<HTMLButtonElement>("[data-next]");
      const bar = story.querySelector<HTMLElement>("[data-progress]");
      const label = folio?.dataset.template ?? "{0} / {1}";

      let leaf = 0;
      let leaves = 1;
      let step = 1;

      function paint() {
        if (folio) folio.textContent = label.replace("{0}", String(leaf + 1)).replace("{1}", String(leaves));
        if (prev) prev.disabled = leaf <= 0;
        if (next) next.disabled = leaf >= leaves - 1;
        if (bar) bar.style.width = `${((leaf + 1) / leaves) * 100}%`;
        nav.hidden = leaves <= 1;
      }

      function turn(to: number, smooth: boolean) {
        leaf = Math.min(leaves - 1, Math.max(0, to));
        pages.scrollTo({
          left: leaf * step,
          behavior: smooth && !reduceMotion.matches ? "smooth" : "auto",
        });
        paint();
      }

      function measure() {
        // Oculto (o en una columna, en móvil) no hay nada que medir.
        if (!pages.clientWidth) return;
        const gap = parseFloat(getComputedStyle(pages).columnGap) || 0;
        step = pages.clientWidth + gap;
        leaves = Math.max(1, Math.ceil((pages.scrollWidth - 2) / step));
        turn(Math.min(leaf, leaves - 1), false);
      }

      prev?.addEventListener("click", () => turn(leaf - 1, true));
      next?.addEventListener("click", () => turn(leaf + 1, true));

      pages.addEventListener("keydown", (event) => {
        if (event.key === "ArrowRight" || event.key === "PageDown") {
          event.preventDefault();
          turn(leaf + 1, true);
        } else if (event.key === "ArrowLeft" || event.key === "PageUp") {
          event.preventDefault();
          turn(leaf - 1, true);
        } else if (event.key === "Home") {
          event.preventDefault();
          turn(0, true);
        } else if (event.key === "End") {
          event.preventDefault();
          turn(leaves - 1, true);
        }
      });

      // Gesto de pasar hoja con el dedo.
      let swipeX: number | null = null;
      pages.addEventListener(
        "touchstart",
        (event) => {
          swipeX = event.changedTouches[0]?.clientX ?? null;
        },
        { passive: true },
      );
      pages.addEventListener(
        "touchend",
        (event) => {
          if (swipeX === null) return;
          const delta = (event.changedTouches[0]?.clientX ?? swipeX) - swipeX;
          swipeX = null;
          if (Math.abs(delta) > 45) turn(leaf + (delta < 0 ? 1 : -1), true);
        },
        { passive: true },
      );

      books.set(story, { measure });
      measure();
    }

    // Las tipografías serif cambian el reparto de columnas al cargar.
    if (document.fonts?.ready) {
      document.fonts.ready.then(() => books.forEach((book) => book.measure()));
    }

    let resizeTimer = 0;
    window.addEventListener("resize", () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        for (const [story, book] of books) if (!story.hidden) book.measure();
      }, 150);
    });

    const fromHash = decodeURIComponent(location.hash.slice(1));
    if (fromHash && stories.some((story) => story.id === fromHash)) {
      show(fromHash, true);
    } else {
      show(stories[0].id, false);
    }

    window.addEventListener("hashchange", () => {
      const id = decodeURIComponent(location.hash.slice(1));
      if (id && stories.some((story) => story.id === id)) show(id, true);
    });
  });
</script>
