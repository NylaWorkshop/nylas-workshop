---
import "../styles/grimoire.css";
import type { StoryRecord } from "../lib/stories";

interface Props {
  stories: StoryRecord[];
  ui: {
    coverTitle: string;
    coverKicker: string;
    coverHint: string;
    close: string;
    next: string;
    prev: string;
    contents: string;
    end: string;
    keysHint: string;
  };
}

type BookPage = {
  kind: string;
  html: string;
};

const { stories, ui } = Astro.props;

function escapeHtml(text: string) {
  return text
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");
}

function ornament(kicker: string, title: string, extra = "") {
  return `<div class="ornament">${
    kicker ? `<p class="ornament-kicker">${escapeHtml(kicker)}</p>` : ""
  }<div class="ornament-flourish" aria-hidden="true"></div><h1 class="ornament-title">${escapeHtml(title)}</h1>${extra}<div class="ornament-flourish" aria-hidden="true"></div></div>`;
}

const pages: BookPage[] = [
  { kind: "endpaper", html: "" },
  { kind: "title", html: ornament(ui.coverKicker, ui.coverTitle) },
];

const tocIndex = pages.length;
pages.push({ kind: "toc", html: "" });

const chapters: { title: string; kicker: string; blurb: string; index: number }[] = [];

for (const story of stories) {
  chapters.push({
    title: story.title,
    kicker: story.kicker,
    blurb: story.blurb,
    index: pages.length,
  });
  pages.push({
    kind: "chapter",
    html: ornament(
      story.kicker,
      story.title,
      story.blurb ? `<p>${escapeHtml(story.blurb)}</p>` : "",
    ),
  });
  for (const leaf of story.pages) {
    const html =
      leaf.kind === "text" && leaf.html.startsWith("<p>")
        ? leaf.html.replace("<p>", '<p class="drop">')
        : leaf.html;
    pages.push({ kind: leaf.kind, html });
  }
}

pages.push({ kind: "title", html: ornament("", ui.end) });
if (pages.length % 2 !== 0) {
  pages.push({ kind: "endpaper", html: "" });
}

pages[tocIndex] = {
  kind: "toc",
  html: `<h2>${escapeHtml(ui.contents)}</h2><div class="toc-list">${chapters
    .map(
      (chapter) =>
        `<button class="toc-item" type="button" data-goto="${chapter.index}"><span class="toc-kicker">${escapeHtml(
          chapter.kicker,
        )}</span><span class="toc-title">${escapeHtml(chapter.title)}</span><span class="toc-blurb">${escapeHtml(
          chapter.blurb,
        )}</span></button>`,
    )
    .join("")}</div>`,
};

const payload = {
  pages,
  ui: {
    next: ui.next,
    prev: ui.prev,
  },
};
---

<section class="lectern" data-grimoire>
  <div class="lectern-aura" aria-hidden="true">
    <span class="aura-glow"></span>
    <svg class="aura-ring aura-ring-a" viewBox="0 0 200 200">
      <circle cx="100" cy="100" r="92" fill="none" stroke="currentColor" stroke-width="0.6" opacity="0.55"></circle>
      <circle cx="100" cy="100" r="84" fill="none" stroke="currentColor" stroke-width="0.35" stroke-dasharray="2 6" opacity="0.7"></circle>
      <circle cx="100" cy="100" r="74" fill="none" stroke="currentColor" stroke-width="0.45" opacity="0.4"></circle>
      {Array.from({ length: 12 }, (_, i) => {
        const a = (i * Math.PI) / 6;
        const x1 = 100 + Math.cos(a) * 88;
        const y1 = 100 + Math.sin(a) * 88;
        const x2 = 100 + Math.cos(a) * 96;
        const y2 = 100 + Math.sin(a) * 96;
        return <line x1={x1.toFixed(1)} y1={y1.toFixed(1)} x2={x2.toFixed(1)} y2={y2.toFixed(1)} stroke="currentColor" stroke-width="0.8"></line>;
      })}
    </svg>
    <svg class="aura-ring aura-ring-b" viewBox="0 0 200 200">
      <circle cx="100" cy="100" r="68" fill="none" stroke="currentColor" stroke-width="0.4" opacity="0.5"></circle>
      <circle cx="100" cy="100" r="58" fill="none" stroke="currentColor" stroke-width="0.3" stroke-dasharray="1 4" opacity="0.65"></circle>
      <polygon
        points="100,38 114,72 150,72 122,94 132,128 100,108 68,128 78,94 50,72 86,72"
        fill="none"
        stroke="currentColor"
        stroke-width="0.45"
        opacity="0.45"
      ></polygon>
    </svg>
    <span class="aura-motes">
      {Array.from({ length: 14 }, () => <i></i>)}
    </span>
  </div>

  <button class="grimoire-closed" type="button" data-open aria-label={ui.coverHint}>
    <span class="closed-block">
      <span class="closed-pages"></span>
      <span class="closed-spine">
        <span class="spine-rib"></span>
        <span class="spine-rib"></span>
        <span class="spine-rib"></span>
        <span class="spine-rib"></span>
        <span class="spine-rib"></span>
      </span>
      <span class="closed-inside" aria-hidden="true"></span>
      <span class="closed-front">
        <img class="cover-plate" src="/grimoire/cover-plate.jpg" alt="" />
      </span>
      <span class="clasp clasp-top"></span>
      <span class="clasp clasp-bot"></span>
    </span>
  </button>

  <div class="grimoire" data-book>
    <div class="grimoire-stage">
      <div class="grimoire-toolbar">
        <p class="grimoire-folio" data-folio></p>
        <button class="grimoire-close" type="button" data-close>{ui.close}</button>
      </div>

      <div class="grimoire-reader">
        <button class="grimoire-nav" type="button" data-prev aria-label={ui.prev}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M15 5 L8 12 L15 19" stroke="currentColor" stroke-width="1.7"></path>
          </svg>
        </button>

        <div class="grimoire-book" data-stage tabindex="0">
          <div class="grimoire-spread">
            <article class="leaf leaf-left" data-left data-kind="">
              <div class="leaf-inner">
                <div class="leaf-html" data-left-html></div>
              </div>
            </article>
            <article class="leaf leaf-right" data-right data-kind="">
              <div class="leaf-inner">
                <div class="leaf-html" data-right-html></div>
              </div>
            </article>

            <div class="flipper flipper-forward" data-flip-forward aria-hidden="true">
              <div class="flip-face flip-front leaf leaf-right" data-ff data-kind="">
                <div class="leaf-inner"><div class="leaf-html" data-ff-html></div></div>
              </div>
              <div class="flip-face flip-rear leaf leaf-left" data-fr data-kind="">
                <div class="leaf-inner"><div class="leaf-html" data-fr-html></div></div>
              </div>
            </div>
            <div class="flipper flipper-back" data-flip-back aria-hidden="true">
              <div class="flip-face flip-front leaf leaf-left" data-bf data-kind="">
                <div class="leaf-inner"><div class="leaf-html" data-bf-html></div></div>
              </div>
              <div class="flip-face flip-rear leaf leaf-right" data-br data-kind="">
                <div class="leaf-inner"><div class="leaf-html" data-br-html></div></div>
              </div>
            </div>
          </div>
        </div>

        <button class="grimoire-nav" type="button" data-next aria-label={ui.next}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M9 5 L16 12 L9 19" stroke="currentColor" stroke-width="1.7"></path>
          </svg>
        </button>
      </div>

      <p class="grimoire-hint">{ui.keysHint}</p>
    </div>
  </div>

  <script type="application/json" data-grimoire-json is:inline set:html={JSON.stringify(payload)}></script>
</section>

<script>
  type BookPage = { kind: string; html: string };

  function toRoman(num: number) {
    if (num <= 0) return "";
    const vals = [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1];
    const syms = ["M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"];
    let n = num;
    let out = "";
    for (let i = 0; i < vals.length; i++) {
      while (n >= vals[i]) {
        out += syms[i];
        n -= vals[i];
      }
    }
    return out;
  }

  function blankPage(): BookPage {
    return { kind: "endpaper", html: "" };
  }

  // El reverso de una hoja que se está volteando: pergamino liso, no guarda marmolada.
  function backPage(): BookPage {
    return { kind: "text", html: "" };
  }

  document.querySelectorAll<HTMLElement>("[data-grimoire]").forEach((root) => {
    const jsonEl = root.querySelector<HTMLScriptElement>("[data-grimoire-json]");
    if (!jsonEl?.textContent) return;

    const data = JSON.parse(jsonEl.textContent) as {
      pages: BookPage[];
      ui: { next: string; prev: string };
    };
    const pages = data.pages;
    const book = root.querySelector("[data-book]") as HTMLElement;
    const closed = root.querySelector("[data-open]") as HTMLButtonElement;
    const cover = closed.querySelector(".closed-front") as HTMLElement | null;
    const closeBtn = root.querySelector("[data-close]") as HTMLButtonElement;
    const prevBtn = root.querySelector("[data-prev]") as HTMLButtonElement;
    const nextBtn = root.querySelector("[data-next]") as HTMLButtonElement;
    const folio = root.querySelector("[data-folio]") as HTMLElement;
    const stage = root.querySelector("[data-stage]") as HTMLElement;
    const leftLeaf = root.querySelector("[data-left]") as HTMLElement;
    const rightLeaf = root.querySelector("[data-right]") as HTMLElement;
    const leftHtml = root.querySelector("[data-left-html]") as HTMLElement;
    const rightHtml = root.querySelector("[data-right-html]") as HTMLElement;
    const flipFwd = root.querySelector("[data-flip-forward]") as HTMLElement;
    const flipBack = root.querySelector("[data-flip-back]") as HTMLElement;
    const ffLeaf = root.querySelector("[data-ff]") as HTMLElement;
    const frLeaf = root.querySelector("[data-fr]") as HTMLElement;
    const bfLeaf = root.querySelector("[data-bf]") as HTMLElement;
    const brLeaf = root.querySelector("[data-br]") as HTMLElement;
    const ffHtml = root.querySelector("[data-ff-html]") as HTMLElement;
    const frHtml = root.querySelector("[data-fr-html]") as HTMLElement;
    const bfHtml = root.querySelector("[data-bf-html]") as HTMLElement;
    const brHtml = root.querySelector("[data-br-html]") as HTMLElement;

    let index = 0;
    let busy = false;
    let open = false;
    let wheelLock = 0;

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const singleMq = window.matchMedia("(max-width: 840px)");

    const isSingle = () => singleMq.matches;
    const step = () => (isSingle() ? 1 : 2);
    const pageAt = (i: number) => pages[i] ?? blankPage();

    // El folio tiene altura fija: si el texto no cabe, encogemos la tipografía
    // en pasos cortos antes de que `overflow: hidden` se lo coma en silencio.
    const MIN_FIT = 0.76;

    // Medir fuerza reflujo síncrono, y durante un volteo se pintan tres hojas
    // seguidas. Cada folio se mide una vez por tamaño de ventana y se recuerda.
    const fitCache = new Map<number, number>();

    function fitLeaf(leaf: HTMLElement, htmlEl: HTMLElement, key?: number) {
      htmlEl.style.removeProperty("--fit");
      if (leaf.dataset.kind !== "text") return;

      if (key !== undefined) {
        const cached = fitCache.get(key);
        if (cached !== undefined) {
          if (cached < 1) htmlEl.style.setProperty("--fit", String(cached));
          return;
        }
      }

      if (!htmlEl.clientHeight) return;

      let fit = 1;
      while (htmlEl.scrollHeight > htmlEl.clientHeight + 1 && fit > MIN_FIT) {
        fit = Math.round((fit - 0.04) * 100) / 100;
        htmlEl.style.setProperty("--fit", String(fit));
      }

      if (key !== undefined) fitCache.set(key, fit);

      if (import.meta.env.DEV && htmlEl.scrollHeight > htmlEl.clientHeight + 1) {
        console.warn(
          "[grimoire] Un folio sigue sin caber al " +
            Math.round(MIN_FIT * 100) +
            "%. Pártelo con <!-- page -->:",
          htmlEl.textContent?.slice(0, 60),
        );
      }
    }

    function paintLeaf(
      leaf: HTMLElement,
      htmlEl: HTMLElement,
      page: BookPage,
      key?: number,
    ) {
      leaf.dataset.kind = page.kind;
      htmlEl.innerHTML = page.html;
      fitLeaf(leaf, htmlEl, key);
    }

    // A rotateY(0) la hoja que gira tapa por completo el folio de debajo, así
    // que el cambio del estático se hace a cubierto, en el frame siguiente.
    // Hacerlo antes deja ver un fotograma del folio destino sin tapar.
    function paintCovered(fn: () => void) {
      requestAnimationFrame(fn);
    }

    function updateFolio() {
      const last = pages.length;
      if (isSingle()) {
        folio.textContent = `${toRoman(index + 1)}  ·  ${toRoman(last)}`;
      } else {
        const right = Math.min(index + 2, last);
        folio.textContent = `${toRoman(index + 1)} — ${toRoman(right)}  ·  ${toRoman(last)}`;
      }
      prevBtn.disabled = index <= 0;
      nextBtn.disabled = index + step() >= pages.length;
    }

    function render() {
      paintLeaf(leftLeaf, leftHtml, pageAt(index), index);
      if (!isSingle()) {
        paintLeaf(rightLeaf, rightHtml, pageAt(index + 1), index + 1);
      }
      updateFolio();
    }

    // En móvil sólo hay un folio a la vista, así que la hoja entera gira sobre
    // el lomo izquierdo y descubre la siguiente, que ya está pintada debajo.
    function singleFlip(nextIndex: number, dir: "fwd" | "back") {
      const flipper = dir === "fwd" ? flipFwd : flipBack;
      const cls = dir === "fwd" ? "is-single-forward" : "is-single-back";

      if (dir === "fwd") {
        paintLeaf(ffLeaf, ffHtml, pageAt(index), index);
        paintLeaf(frLeaf, frHtml, backPage());
      } else {
        paintLeaf(bfLeaf, bfHtml, pageAt(nextIndex), nextIndex);
        paintLeaf(brLeaf, brHtml, backPage());
      }

      flipper.classList.add("is-on", cls);

      if (dir === "fwd") {
        paintCovered(() => paintLeaf(leftLeaf, leftHtml, pageAt(nextIndex), nextIndex));
      }
      flipper.addEventListener(
        "animationend",
        () => {
          flipper.classList.remove("is-on", cls);
          index = nextIndex;
          render();
          busy = false;
        },
        { once: true },
      );
    }

    function goto(target: number, animate: "none" | "fwd" | "back") {
      const max = isSingle() ? pages.length - 1 : pages.length - step();
      const nextIndex = Math.max(0, Math.min(target, max));
      if (nextIndex === index || busy) return;

      if (animate === "none" || reduceMotion.matches) {
        index = nextIndex;
        render();
        return;
      }

      busy = true;

      if (isSingle()) {
        singleFlip(nextIndex, animate);
        return;
      }

      if (animate === "fwd") {
        paintLeaf(ffLeaf, ffHtml, pageAt(index + 1), index + 1);
        paintLeaf(frLeaf, frHtml, pageAt(nextIndex), nextIndex);
        flipFwd.classList.add("is-on", "is-forward");
        paintCovered(() =>
          paintLeaf(rightLeaf, rightHtml, pageAt(nextIndex + 1), nextIndex + 1),
        );
        const end = () => {
          flipFwd.classList.remove("is-on", "is-forward");
          index = nextIndex;
          render();
          busy = false;
        };
        flipFwd.addEventListener("animationend", end, { once: true });
      } else {
        paintLeaf(bfLeaf, bfHtml, pageAt(index), index);
        paintLeaf(brLeaf, brHtml, pageAt(nextIndex + 1), nextIndex + 1);
        flipBack.classList.add("is-on", "is-backward");
        paintCovered(() =>
          paintLeaf(leftLeaf, leftHtml, pageAt(nextIndex), nextIndex),
        );
        const end = () => {
          flipBack.classList.remove("is-on", "is-backward");
          index = nextIndex;
          render();
          busy = false;
        };
        flipBack.addEventListener("animationend", end, { once: true });
      }
    }

    // La tapa gira sobre el lomo antes de dar paso al pliego. `animationend`
    // puede no llegar (pestaña en segundo plano), así que hay red de seguridad.
    function onceAnimated(el: HTMLElement | null, ms: number, done: () => void) {
      let fired = false;
      const run = () => {
        if (fired) return;
        fired = true;
        done();
      };
      el?.addEventListener("animationend", run, { once: true });
      window.setTimeout(run, ms);
    }

    function revealBook() {
      closed.hidden = true;
      closed.classList.remove("is-opening");
      book.classList.add("is-open");
      index = 0;
      render();
      stage.focus();
    }

    function openBook() {
      if (open || busy) return;
      open = true;
      root.classList.add("is-open");

      if (reduceMotion.matches) {
        revealBook();
        return;
      }

      busy = true;
      closed.classList.add("is-opening");
      onceAnimated(cover, 1200, () => {
        busy = false;
        revealBook();
      });
    }

    function closeBook() {
      if (!open) return;
      open = false;
      book.classList.remove("is-open");
      busy = false;
      flipFwd.classList.remove("is-on", "is-forward", "is-single-forward");
      flipBack.classList.remove("is-on", "is-backward", "is-single-back");
      closed.hidden = false;

      if (reduceMotion.matches) {
        root.classList.remove("is-open");
        return;
      }

      closed.classList.add("is-closing");
      onceAnimated(cover, 1000, () => {
        closed.classList.remove("is-closing");
        root.classList.remove("is-open");
      });
      closed.focus();
    }

    closed.addEventListener("click", openBook);
    closeBtn.addEventListener("click", closeBook);
    nextBtn.addEventListener("click", () => goto(index + step(), "fwd"));
    prevBtn.addEventListener("click", () => goto(index - step(), "back"));

    stage.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      const jump = target.closest<HTMLElement>("[data-goto]");
      if (jump) {
        event.stopPropagation();
        goto(Number(jump.dataset.goto), "none");
        return;
      }
      if (busy || !open) return;
      const rect = stage.getBoundingClientRect();
      const x = (event as MouseEvent).clientX - rect.left;
      if (isSingle()) {
        if (x > rect.width * 0.45) goto(index + 1, "fwd");
        else goto(index - 1, "back");
      } else if (x > rect.width * 0.5) {
        goto(index + 2, "fwd");
      } else {
        goto(index - 2, "back");
      }
    });

    stage.addEventListener(
      "wheel",
      (event) => {
        if (!open) return;
        event.preventDefault();
        const now = Date.now();
        if (now - wheelLock < 650 || busy) return;
        if (Math.abs(event.deltaY) < 12) return;
        wheelLock = now;
        if (event.deltaY > 0) goto(index + step(), "fwd");
        else goto(index - step(), "back");
      },
      { passive: false },
    );

    let touchX = 0;
    stage.addEventListener("touchstart", (event) => {
      touchX = event.changedTouches[0]?.clientX ?? 0;
    });
    stage.addEventListener("touchend", (event) => {
      const x = event.changedTouches[0]?.clientX ?? 0;
      const dx = x - touchX;
      if (Math.abs(dx) < 40) return;
      if (dx < 0) goto(index + step(), "fwd");
      else goto(index - step(), "back");
    });

    window.addEventListener("keydown", (event) => {
      if (!open) {
        if (event.key === "Enter" && document.activeElement === closed) return;
        return;
      }
      if (event.key === "ArrowRight" || event.key === " " || event.key === "PageDown") {
        event.preventDefault();
        goto(index + step(), "fwd");
      } else if (event.key === "ArrowLeft" || event.key === "PageUp") {
        event.preventDefault();
        goto(index - step(), "back");
      } else if (event.key === "Escape") {
        closeBook();
      }
    });

    singleMq.addEventListener("change", () => {
      fitCache.clear();
      if (open) render();
    });

    // El auto-ajuste mide texto: hay que rehacerlo cuando cambian la caja o la
    // tipografía real (Cormorant llega por webfont, después del primer pintado).
    let resizeTimer = 0;
    window.addEventListener("resize", () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        fitCache.clear();
        if (open && !busy) render();
      }, 150);
    });

    document.fonts?.ready.then(() => {
      fitCache.clear();
      if (open && !busy) render();
    });
  });
</script>
