---
import { xPosts, xProfile } from "../data/x-feed";
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";
import { asset } from "../lib/paths";

const lang = (Astro.currentLocale ?? "es") as Lang;
const t = useTranslations(lang);

const dateFmt = new Intl.DateTimeFormat(lang === "en" ? "en-GB" : "es", {
  day: "numeric",
  month: "short",
});
---

<section class="mx-auto max-w-6xl px-5 pt-16 md:pt-24">
  <div class="mb-10 flex flex-col items-center text-center">
    <div class="flourish">
      <span class="flourish-line"></span>
      <h2 class="font-display gold-text text-2xl tracking-[0.18em] uppercase md:text-3xl">
        {t("home.x.title")}
      </h2>
      <span class="flourish-line"></span>
    </div>
    <a
      href={xProfile.url}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-4 inline-flex items-center gap-3 text-cream transition hover:text-gold"
    >
      <img
        src={asset(xProfile.avatar)}
        alt=""
        class="h-9 w-9 rounded-full object-cover ring-1 ring-gold/35"
      />
      <span class="leading-tight text-left">
        <span class="font-display block text-[0.95rem]">{xProfile.name}</span>
        <span class="block text-[0.72rem] tracking-[0.08em] text-gold/80">@{xProfile.handle}</span>
      </span>
    </a>
    <p class="mt-3 max-w-md text-sm text-muted">{t("home.x.lead")}</p>
  </div>

  <div class="x-feed">
    {xPosts.map((post) => (
      <a
        class="x-post"
        href={`${xProfile.url}/status/${post.id}`}
        target="_blank"
        rel="noopener noreferrer"
      >
        {post.image && (
          <img class="x-post-image" src={asset(post.image)} alt="" />
        )}
        <div class="x-post-body">
          <p class="x-post-meta">
            <span>@{xProfile.handle}</span>
            <span aria-hidden="true">·</span>
            <time datetime={post.createdAt}>{dateFmt.format(new Date(post.createdAt))}</time>
          </p>
          {post.text && <p class="x-post-text">{post.text}</p>}
          <span class="x-post-open">{t("home.x.open")}</span>
        </div>
      </a>
    ))}
  </div>

  <div class="mt-8 flex justify-center">
    <a
      href={xProfile.url}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-gold-outline inline-flex items-center gap-2"
    >
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.727-8.835L1.254 2.25H8.08l4.253 5.622L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"></path>
      </svg>
      {t("home.x.cta")}
    </a>
  </div>
</section>
