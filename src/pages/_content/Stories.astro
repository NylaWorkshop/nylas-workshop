---
import Layout from "../../layouts/Layout.astro";
import Grimoire from "../../components/Grimoire.astro";
import { getStories } from "../../lib/stories";
import { useTranslations } from "../../i18n/utils";

const t = useTranslations(Astro.currentLocale);
const stories = getStories(Astro.currentLocale);
---

<Layout title={t("meta.storiesTitle")} description={t("meta.storiesDesc")}>
  <section class="mx-auto max-w-6xl px-5 pb-4 pt-14">
    <p class="banner-title">{t("stories.kicker")}</p>
    <h1 class="font-display gold-text mt-3 text-3xl md:text-4xl">{t("stories.title")}</h1>
    <p class="mt-4 max-w-2xl text-base text-muted">
      {t("stories.lead")}
    </p>
  </section>

  <Grimoire
    stories={stories}
    ui={{
      coverTitle: t("stories.coverTitle"),
      coverKicker: t("stories.coverKicker"),
      coverHint: t("stories.coverHint"),
      close: t("stories.close"),
      next: t("stories.next"),
      prev: t("stories.prev"),
      contents: t("stories.contents"),
      end: t("stories.end"),
      keysHint: t("stories.keysHint"),
    }}
  />
</Layout>
