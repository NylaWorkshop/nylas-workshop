---
import Layout from "../../layouts/Layout.astro";
import StoryReader from "../../components/StoryReader.astro";
import { getStories } from "../../lib/stories";
import { useTranslations } from "../../i18n/utils";
import { asset } from "../../lib/paths";

const t = useTranslations(Astro.currentLocale);
const stories = getStories(Astro.currentLocale);
---

<Layout title={t("meta.storiesTitle")} description={t("meta.storiesDesc")}>
  <section class="mx-auto max-w-6xl px-5 pb-4 pt-14">
    <p class="banner-title">{t("stories.kicker")}</p>
    <h1 class="font-display gold-text mt-3 text-3xl md:text-4xl">{t("stories.title")}</h1>
    <p class="mt-4 max-w-2xl text-base text-muted">
      {t("stories.lead")}
    </p>
  </section>

  <StoryReader
    stories={stories}
    ui={{
      shelf: t("stories.shelf"),
      shelfAria: t("stories.shelfAria"),
      now: t("stories.now"),
      readTime: t("stories.readTime"),
      folios: t("stories.folios"),
      end: t("stories.end"),
      top: t("stories.top"),
      note: t("stories.note"),
      prev: t("stories.prev"),
      next: t("stories.next"),
      spreadAria: t("stories.spreadAria"),
      spreadOf: t("stories.spreadOf"),
    }}
  />

  <section class="mx-auto max-w-6xl px-5 pb-16 pt-12 md:pt-16">
    <figure class="stories-plate">
      <div class="shop-frame shop-frame-stories">
        <img src={asset("/stories/relato-1.jpg")} alt={t("stories.plateAlt")} loading="lazy" />
      </div>
      <figcaption>{t("stories.plateCaption")}</figcaption>
    </figure>
  </section>
</Layout>
