---
import Layout from "../../layouts/Layout.astro";
import { formatPrice, shopProducts, shopUrl } from "../../data/shop";
import { useTranslations } from "../../i18n/utils";

const t = useTranslations(Astro.currentLocale);
const lang = Astro.currentLocale ?? "es";
---

<Layout title={t("meta.merchTitle")} description={t("meta.merchDesc")}>
  <section class="mx-auto max-w-6xl px-5 pb-10 pt-14">
    <p class="banner-title">{t("merch.kicker")}</p>
    <h1 class="font-display gold-text mt-3 text-3xl md:text-4xl">{t("merch.title")}</h1>
    <p class="mt-4 max-w-2xl text-base text-muted">
      {t("merch.lead")}
    </p>
  </section>

  <section class="mx-auto grid max-w-6xl gap-5 px-5 sm:grid-cols-2 lg:grid-cols-3">
    {shopProducts.map((item) => (
      <a class="shop-card" href={item.href} target="_blank" rel="noopener noreferrer">
        <span class="shop-card-media">
          <img src={item.image} alt={item.title} />
        </span>
        <span class="shop-card-body">
          {item.compareAt && (
            <span class="shop-badge">{t("merch.sale")}</span>
          )}
          <h2 class="font-display mt-2 text-lg text-cream">{item.title}</h2>
          <p class="mt-2 text-sm text-muted">{t(item.noteKey)}</p>
          <p class="shop-price">
            {item.compareAt && (
              <s>{formatPrice(item.compareAt, lang)}</s>
            )}
            <strong>{formatPrice(item.price, lang)}</strong>
          </p>
          <span class="shop-buy">{t("merch.buy")}</span>
        </span>
      </a>
    ))}
  </section>

  <div class="mx-auto mt-10 flex max-w-6xl justify-center px-5">
    <a class="btn-gold" href={shopUrl} target="_blank" rel="noopener noreferrer">
      {t("merch.shopCta")}
    </a>
  </div>
</Layout>
