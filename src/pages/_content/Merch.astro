---
import Layout from "../../layouts/Layout.astro";
import { useTranslations } from "../../i18n/utils";

const t = useTranslations(Astro.currentLocale);

const items = [
  { title: t("merch.mug"), note: t("merch.mugNote") },
  { title: t("merch.print"), note: t("merch.printNote") },
  { title: t("merch.stickers"), note: t("merch.stickersNote") },
];
---

<Layout title={t("meta.merchTitle")} description={t("meta.merchDesc")}>
  <section class="mx-auto max-w-6xl px-5 pb-10 pt-14">
    <p class="banner-title">{t("merch.kicker")}</p>
    <h1 class="font-display gold-text mt-3 text-3xl md:text-4xl">{t("merch.title")}</h1>
    <p class="mt-4 max-w-2xl text-base text-muted">
      {t("merch.lead")}
    </p>
  </section>

  <section class="mx-auto grid max-w-6xl gap-5 px-5 sm:grid-cols-2 lg:grid-cols-3">
    {items.map((item) => (
      <article class="card-frame rounded-3xl p-6">
        <span class="rounded-full border border-gold/25 px-3 py-1 text-[0.65rem] uppercase tracking-[0.18em] text-gold-soft">
          {t("merch.status")}
        </span>
        <h2 class="font-display mt-4 text-lg text-cream">{item.title}</h2>
        <p class="mt-3 text-sm text-muted">{item.note}</p>
      </article>
    ))}
  </section>
</Layout>
