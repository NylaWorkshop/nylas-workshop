---
import Layout from "../../layouts/Layout.astro";
import { useTranslations } from "../../i18n/utils";

const t = useTranslations(Astro.currentLocale);
const xDm = "https://x.com/messages/compose?recipient_id=1928211827449581568";
const xProfile = "https://x.com/NylaKatsuki";

const services = [
  { mark: "</>", title: t("code.web.title"), text: t("code.web.text") },
  { mark: "{ }", title: t("code.app.title"), text: t("code.app.text") },
  { mark: "✦", title: t("code.craft.title"), text: t("code.craft.text") },
];

const steps = [
  { n: "01", title: t("code.step1.title"), text: t("code.step1.text") },
  { n: "02", title: t("code.step2.title"), text: t("code.step2.text") },
  { n: "03", title: t("code.step3.title"), text: t("code.step3.text") },
];
---

<Layout title={t("meta.codeTitle")} description={t("meta.codeDesc")}>
  <section class="mx-auto grid max-w-6xl items-center gap-10 px-5 pb-10 pt-14 md:grid-cols-[1.05fr_0.95fr] md:gap-12 md:pb-16">
    <div>
      <p class="banner-title">{t("code.kicker")}</p>
      <h1 class="font-display gold-text mt-3 text-3xl md:text-4xl">{t("code.title")}</h1>
      <p class="mt-4 max-w-xl text-base leading-relaxed text-muted">
        {t("code.lead")}
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          class="btn-gold inline-flex items-center gap-2"
          href={xDm}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={t("code.ctaAria")}
        >
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.727-8.835L1.254 2.25H8.08l4.253 5.622L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"></path>
          </svg>
          {t("code.cta")}
        </a>
        <a
          class="btn-gold-outline"
          href={xProfile}
          target="_blank"
          rel="noopener noreferrer"
        >
          @NylaKatsuki
        </a>
      </div>
    </div>

    <figure class="desk-frame">
      <img src="/code/nyla-desk.jpg" alt={t("code.imageAlt")} />
      <figcaption class="desk-caption">{t("code.heroMark")}</figcaption>
    </figure>
  </section>

  <section class="mx-auto max-w-6xl px-5 pt-4 md:pt-8">
    <div class="grid gap-4 md:grid-cols-3">
      {services.map((service) => (
        <article class="card-frame rounded-2xl px-5 py-6">
          <h2 class="font-display flex items-center gap-2.5 text-lg text-cream">
            <span class="inline-flex shrink-0 text-gold" aria-hidden="true">
              <span class="text-[0.95em] leading-none tracking-tight">{service.mark}</span>
            </span>
            {service.title}
          </h2>
          <p class="mt-2 text-sm leading-relaxed text-muted">{service.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pt-16 md:pt-24">
    <div class="mb-8 flex flex-col items-center text-center">
      <div class="flourish">
        <span class="flourish-line"></span>
        <h2 class="font-display gold-text text-2xl tracking-[0.18em] uppercase md:text-3xl">
          {t("code.how")}
        </h2>
        <span class="flourish-line"></span>
      </div>
    </div>
    <ol class="grid gap-4 md:grid-cols-3">
      {steps.map((step) => (
        <li class="card-frame rounded-2xl px-5 py-6">
          <p class="font-display text-[0.68rem] tracking-[0.28em] text-gold">{step.n}</p>
          <h3 class="font-display mt-3 text-lg text-cream">{step.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{step.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="mx-auto max-w-6xl px-5 pt-16 md:pt-24">
    <div class="code-cta">
      <p class="font-display text-[0.68rem] uppercase tracking-[0.32em] text-gold">{t("code.ctaKicker")}</p>
      <h2 class="font-display gold-text mt-3 text-2xl md:text-3xl">{t("code.ctaTitle")}</h2>
      <p class="mt-3 max-w-lg text-sm leading-relaxed text-muted">{t("code.ctaLead")}</p>
      <a
        class="btn-gold mt-6 inline-flex items-center gap-2"
        href={xDm}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t("code.ctaAria")}
      >
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.727-8.835L1.254 2.25H8.08l4.253 5.622L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"></path>
        </svg>
        {t("code.cta")}
      </a>
    </div>
  </section>
</Layout>
