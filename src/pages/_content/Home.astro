---
import Layout from "../../layouts/Layout.astro";
import XFeed from "../../components/XFeed.astro";
import type { Lang } from "../../i18n/ui";
import { localizePath, useTranslations } from "../../i18n/utils";

const lang = (Astro.currentLocale ?? "es") as Lang;
const t = useTranslations(lang);

const pillars = [
  { icon: "star" as const, title: t("home.pillar.stories"), text: t("home.pillar.storiesText") },
  { icon: "game" as const, title: t("home.pillar.games"), text: t("home.pillar.gamesText") },
  { icon: "code" as const, title: t("home.pillar.code"), text: t("home.pillar.codeText") },
];

const sections = [
  { href: "/bookstore", label: t("nav.bookstore"), icon: "book" as const },
  { href: "/music", label: t("nav.music"), icon: "music" as const },
  { href: "/stories", label: t("nav.stories"), icon: "feather" as const },
  { href: "/games", label: t("nav.games"), icon: "gamepad" as const },
  { href: "/code", label: t("nav.code"), icon: "code" as const },
  { href: "/merch", label: t("nav.merch"), icon: "mug" as const },
];
---

<Layout title={t("meta.homeTitle")} description={t("meta.homeDesc")}>
  <div class="moon-wash">
  <section class="relative">
    <div class="mx-auto grid max-w-6xl items-center gap-8 px-5 pb-16 pt-8 md:grid-cols-[1fr_0.9fr] md:gap-12 md:pb-24 md:pt-12">
      <div class="order-2 text-center md:order-1 md:text-left">
        <p class="banner-title justify-center md:justify-start">{t("home.kicker")}</p>
        <h1 class="font-display gold-text mt-5 max-w-xl text-[1.85rem] leading-[1.15] sm:text-[2.15rem] md:text-[2.35rem]">
          {t("home.title")}
        </h1>
        <p class="mt-5 max-w-lg text-base text-paper/90 md:text-[1.05rem]">
          {t("home.lead")}
        </p>
        <nav
          class="mt-8 flex flex-wrap items-center justify-center gap-3 md:justify-start"
          aria-label={t("home.sectionsAria")}
        >
          {sections.map((section) => (
            <a href={localizePath(lang, section.href)} class="btn-icon" aria-label={section.label}>
              <svg
                class="h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                {section.icon === "book" && (
                  <>
                    <path d="M12 7v14"></path>
                    <path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3Z"></path>
                  </>
                )}
                {section.icon === "music" && (
                  <>
                    <path d="M9 18V5l12-2v13"></path>
                    <circle cx="6" cy="18" r="3"></circle>
                    <circle cx="18" cy="16" r="3"></circle>
                  </>
                )}
                {section.icon === "feather" && (
                  <>
                    <path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5Z"></path>
                    <path d="M16 8 2 22"></path>
                    <path d="M17.5 15H9"></path>
                  </>
                )}
                {section.icon === "gamepad" && (
                  <>
                    <path d="M6.4 9.4h11.2a3.7 3.7 0 0 1 3.6 4.5l-.5 1.55a1.75 1.75 0 0 1-1.7 1.25h-1.25a1.55 1.55 0 0 1-1.25-.7l-.5-.7H8.7l-.5.7a1.55 1.55 0 0 1-1.25.7H5.7a1.75 1.75 0 0 1-1.7-1.25L3.5 13.9a3.7 3.7 0 0 1 2.9-4.5Z"></path>
                    <path d="M8.15 12.15v2.35M7 13.32h2.3"></path>
                    <circle cx="15.15" cy="12.55" r="0.55" fill="currentColor" stroke="none"></circle>
                    <circle cx="17" cy="14.05" r="0.55" fill="currentColor" stroke="none"></circle>
                  </>
                )}
                {section.icon === "code" && (
                  <>
                    <path d="m16 18 6-6-6-6"></path>
                    <path d="m8 6-6 6 6 6"></path>
                  </>
                )}
                {section.icon === "mug" && (
                  <>
                    <path d="M10 2v2M14 2v2"></path>
                    <path d="M4 8h13v9a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4Z"></path>
                    <path d="M17 10h1.5a2.75 2.75 0 0 1 0 5.5H17"></path>
                  </>
                )}
              </svg>
              <span class="btn-icon-label">{section.label}</span>
            </a>
          ))}
        </nav>
      </div>

      <div class="order-1 flex justify-center md:order-2">
        <div class="relative">
          <div class="absolute inset-8 rounded-full bg-[radial-gradient(circle,rgba(245,240,230,0.2),transparent_68%)] blur-2xl"></div>
          <img
            src="/logo.png"
            alt={t("home.logoAlt")}
            class="relative w-[min(26rem,86vw)] drop-shadow-[0_0_40px_rgba(232,201,122,0.18)]"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="relative mx-auto max-w-6xl px-5 pt-6 md:pt-10">
    <div class="mb-10 flex flex-col items-center text-center">
      <div class="flourish">
        <span class="flourish-line"></span>
        <h2 class="font-display gold-text text-2xl tracking-[0.18em] uppercase md:text-3xl">
          {t("home.workshop")}
        </h2>
        <span class="flourish-line"></span>
      </div>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {pillars.map((pillar) => (
        <article class="card-frame rounded-2xl px-5 py-5">
          <h2 class="font-display flex items-center gap-2.5 text-lg text-cream">
            <span class="inline-flex shrink-0 text-gold" aria-hidden="true">
              {pillar.icon === "star" && <span class="text-[1.05em] leading-none">✦</span>}
              {pillar.icon === "game" && (
                <svg
                  class="h-[1.05em] w-[1.05em]"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M6.4 9.4h11.2a3.7 3.7 0 0 1 3.6 4.5l-.5 1.55a1.75 1.75 0 0 1-1.7 1.25h-1.25a1.55 1.55 0 0 1-1.25-.7l-.5-.7H8.7l-.5.7a1.55 1.55 0 0 1-1.25.7H5.7a1.75 1.75 0 0 1-1.7-1.25L3.5 13.9a3.7 3.7 0 0 1 2.9-4.5Z"></path>
                  <path d="M8.15 12.15v2.35M7 13.32h2.3"></path>
                  <circle cx="15.15" cy="12.55" r="0.55" fill="currentColor" stroke="none"></circle>
                  <circle cx="17" cy="14.05" r="0.55" fill="currentColor" stroke="none"></circle>
                </svg>
              )}
              {pillar.icon === "code" && <span class="text-[0.95em] leading-none tracking-tight">&lt;/&gt;</span>}
            </span>
            {pillar.title}
          </h2>
          <p class="mt-2 text-sm leading-relaxed text-muted">{pillar.text}</p>
        </article>
      ))}
    </div>
  </section>
  </div>

  <section class="mx-auto max-w-6xl px-5 pt-16 md:pt-24">
    <div class="mb-10 flex flex-col items-center text-center">
      <div class="flourish">
        <span class="flourish-line"></span>
        <h2 class="font-display gold-text text-2xl tracking-[0.18em] uppercase md:text-3xl">
          {t("home.table")}
        </h2>
        <span class="flourish-line"></span>
      </div>
      <p class="font-display mt-4 text-xl text-cream md:text-[1.35rem]">
        {t("home.forging")}
      </p>
    </div>

    <div class="workbench">
      <a class="dossier" href={`${localizePath(lang, "/games")}#wireghost`}>
        <div>
          <span class="dossier-tab">{t("home.wireghostTag")}</span>
          <h3 class="font-display gold-text text-2xl">Wireghost</h3>
          <p class="mt-3 max-w-md text-sm leading-relaxed text-muted">
            {t("home.wireghostDesc")}
          </p>
        </div>
        <p class="mt-8 font-display text-[0.65rem] uppercase tracking-[0.24em] text-gold">
          {t("home.wireghostStatus")}
        </p>
      </a>

      <div class="slip-stack">
        <a class="slip-note" href={`${localizePath(lang, "/games")}#cuaderno`}>
          <p class="font-display text-[0.62rem] uppercase tracking-[0.28em] text-gold/80">
            {t("home.table.storiesTag")} · {t("home.table.storiesStatus")}
          </p>
          <h3 class="font-display mt-2 text-lg text-cream">{t("home.table.storiesTitle")}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{t("home.table.storiesDesc")}</p>
        </a>
        <a class="slip-ticket" href={localizePath(lang, "/merch")}>
          <p class="font-display text-[0.62rem] uppercase tracking-[0.28em] text-gold/80">
            {t("home.table.merchTag")} · {t("home.table.merchStatus")}
          </p>
          <h3 class="font-display mt-2 text-lg text-cream">{t("home.table.merchTitle")}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{t("home.table.merchDesc")}</p>
        </a>
      </div>
    </div>
  </section>

  <XFeed />
</Layout>
