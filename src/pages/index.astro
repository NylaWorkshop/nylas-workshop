---
import Layout from "../layouts/Layout.astro";
import GameCard from "../components/GameCard.astro";

const pillars = [
  {
    mark: "</>",
    title: "Código",
    text: "Sistemas, interfaces y herramientas hechas a mano, con la misma paciencia que una taza que se enfría al lado del teclado.",
  },
  {
    mark: "▣",
    title: "Juegos",
    text: "Mundos para perderse un rato: narrativa, puzzles y esa sensación de haber encontrado un secreto que no estaba en la guía.",
  },
  {
    mark: "✦",
    title: "Historias",
    text: "Libros, cafés y libretas abiertas. El taller también es un rincón cálido donde las ideas se quedan a dormir.",
  },
];
---

<Layout
  title="Nyla's Workshop"
  description="Taller de una gata programadora y gamedev. Juegos, código, libros y café."
>
  <section class="moon-glow relative overflow-hidden">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 pb-16 pt-10 md:grid-cols-[1.05fr_0.95fr] md:pb-24 md:pt-16">
      <div class="order-2 text-center md:order-1 md:text-left">
        <p class="banner-title justify-center md:justify-start">Workshop</p>
        <h1 class="font-display mt-4 text-5xl leading-[0.95] gold-text sm:text-6xl md:text-7xl">
          Nyla's
        </h1>
        <p class="mt-5 max-w-xl text-lg text-paper/90 md:text-xl">
          Taller de una gata que programa, diseña juegos y se toma el café demasiado en serio.
        </p>
        <p class="mt-4 max-w-xl text-muted">
          Oscuro, pero cálido. Como la luz del círculo del logo: libros apilados, un mando a medio
          alcance y una pantalla con código encendido.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3 md:justify-start">
          <a
            href="/games"
            class="rounded-full bg-gold px-6 py-3 font-display text-[0.72rem] uppercase tracking-[0.28em] text-ink transition hover:bg-gold-soft"
          >
            Ver juegos
          </a>
          <a
            href="/merch"
            class="rounded-full border border-gold/35 px-6 py-3 font-display text-[0.72rem] uppercase tracking-[0.28em] text-gold transition hover:border-gold hover:text-gold-soft"
          >
            El mostrador
          </a>
        </div>
      </div>

      <div class="order-1 flex justify-center md:order-2">
        <div class="relative">
          <div class="absolute inset-6 rounded-full bg-[radial-gradient(circle,rgba(245,240,230,0.2),transparent_68%)] blur-2xl"></div>
          <img
            src="/logo.png"
            alt="Logo de Nyla's Workshop: Nyla de perfil, entre libros, café, un mando y una pantalla de código."
            class="relative w-[min(28rem,88vw)] drop-shadow-[0_0_40px_rgba(232,201,122,0.18)]"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5">
    <div class="flourish mb-8">
      <span class="flourish-line"></span>
      <span class="font-display text-[0.68rem] uppercase tracking-[0.4em] text-gold">El taller</span>
      <span class="flourish-line"></span>
    </div>
    <div class="grid gap-5 md:grid-cols-3">
      {pillars.map((pillar) => (
        <article class="card-frame rounded-3xl p-6">
          <p class="font-display text-2xl text-gold">{pillar.mark}</p>
          <h2 class="font-display mt-4 text-2xl text-cream">{pillar.title}</h2>
          <p class="mt-3 text-sm leading-relaxed text-muted">{pillar.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="mx-auto mt-20 max-w-6xl px-5">
    <div class="mb-8 flex flex-col items-start justify-between gap-4 md:flex-row md:items-end">
      <div>
        <p class="banner-title">En la mesa</p>
        <h2 class="font-display mt-3 text-3xl text-cream md:text-4xl">Lo que se está forjando</h2>
      </div>
      <a href="/games" class="font-display text-[0.7rem] uppercase tracking-[0.28em] text-gold hover:text-gold-soft">
        Todos los juegos →
      </a>
    </div>
    <GameCard
      featured
      href="/games#wireghost"
      title="Wireghost"
      tag="Aventura hacker"
      status="En el taller"
      description="Una investigación desde una terminal Linux de verdad. Estética cyberpunk noventera, casos que la policía archiva demasiado rápido y cuatro operadoras con garras distintas."
    />
  </section>
</Layout>
