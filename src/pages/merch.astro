---
import Layout from "../layouts/Layout.astro";

const items = [
  {
    title: "Taza del taller",
    note: "Huella dorada, café de verdad.",
    status: "En el horno",
  },
  {
    title: "Print del logo",
    note: "Nyla, la luna y el círculo cálido.",
    status: "En el horno",
  },
  {
    title: "Stickers",
    note: "Lunas, garras y un </ > bien puesto.",
    status: "En el horno",
  },
];
---

<Layout
  title="Merch"
  description="Merch de Nyla's Workshop. Aún en el horno: tazas, prints y stickers."
>
  <section class="mx-auto max-w-6xl px-5 pb-10 pt-14">
    <p class="banner-title">Mostrador</p>
    <h1 class="font-display mt-4 text-4xl gold-text md:text-6xl">Merch</h1>
    <p class="mt-5 max-w-2xl text-lg text-muted">
      El mostrador todavía huele a barniz y a café recién hecho. Nada se vende todavía: se está
      forjando con el mismo cuidado que el logo.
    </p>
  </section>

  <section class="mx-auto grid max-w-6xl gap-5 px-5 sm:grid-cols-2 lg:grid-cols-3">
    {items.map((item) => (
      <article class="card-frame rounded-3xl p-6">
        <span class="rounded-full border border-gold/25 px-3 py-1 text-[0.65rem] uppercase tracking-[0.18em] text-gold-soft">
          {item.status}
        </span>
        <h2 class="font-display mt-5 text-2xl text-cream">{item.title}</h2>
        <p class="mt-3 text-sm text-muted">{item.note}</p>
      </article>
    ))}
  </section>
</Layout>
