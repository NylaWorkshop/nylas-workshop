---
import Layout from "../layouts/Layout.astro";
import GameCard from "../components/GameCard.astro";

const games = [
  {
    id: "wireghost",
    title: "Wireghost",
    tag: "Aventura · Terminal",
    status: "En el taller",
    description:
      "Te metes en la piel de una operadora de Red Sombra. Resuelves casos desde una terminal Linux real: nmap, logs, criptografía y una barra de traza que no perdona si dejas huella. Elige a Nyla, Tsuki, Elowen o Scarlet y decide si juegas guiado o a pulso.",
  },
  {
    id: "cuaderno",
    title: "Proyectos en el cuaderno",
    tag: "Próximamente",
    status: "Bocetos",
    description:
      "Hay más ideas entre las páginas: mundos pequeños, prototipos y experimentos que todavía huelen a café. Cuando estén listos para salir del taller, aparecerán aquí.",
  },
];
---

<Layout
  title="Juegos"
  description="Juegos del taller de Nyla: Wireghost y lo que aún se está forjando."
>
  <section class="mx-auto max-w-6xl px-5 pb-10 pt-14">
    <p class="banner-title">Ludoteca</p>
    <h1 class="font-display mt-4 text-4xl gold-text md:text-6xl">Juegos</h1>
    <p class="mt-5 max-w-2xl text-lg text-muted">
      En el taller se construyen partidas para husmear, perderse y volver con las orejas de punta.
      Algunos ya tienen nombre. Otros todavía viven en la libreta.
    </p>
  </section>

  <section class="mx-auto grid max-w-6xl gap-6 px-5 md:grid-cols-2">
    {games.map((game) => (
      <div id={game.id}>
        <GameCard
          title={game.title}
          tag={game.tag}
          status={game.status}
          description={game.description}
          featured={game.id === "wireghost"}
        />
      </div>
    ))}
  </section>
</Layout>
